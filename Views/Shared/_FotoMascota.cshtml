@model Mascota
@* Foto de la mascota o marcador con huella si no tiene *@
@if (!string.IsNullOrEmpty(Model.RutaFoto))
{
    <img src="@Model.RutaFoto" alt="Foto de @Model.Nombre" loading="lazy" />
}
else
{
    <span class="foto-vacia" role="img" aria-label="@Model.Nombre sin foto">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><ellipse cx="6" cy="9.5" rx="2.1" ry="2.7"/><ellipse cx="10" cy="5.6" rx="2.1" ry="2.8"/><ellipse cx="14" cy="5.6" rx="2.1" ry="2.8"/><ellipse cx="18" cy="9.5" rx="2.1" ry="2.7"/><path d="M12 11.2c-3 0-6 3.4-6 6.1 0 1.8 1.4 2.7 3 2.7 1.3 0 2-.6 3-.6s1.7.6 3 .6c1.6 0 3-.9 3-2.7 0-2.7-3-6.1-6-6.1Z"/></svg>
    </span>
}
