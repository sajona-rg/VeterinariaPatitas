@{
    var controlador = ViewContext.RouteData.Values["controller"]?.ToString();
    string Activo(string c) => string.Equals(controlador, c, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Patitas</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
</head>
<body>
    <div class="app">
        <!-- Barra lateral: fija en escritorio, offcanvas en móvil -->
        <aside class="offcanvas-lg offcanvas-start app-sidebar" tabindex="-1" id="menuLateral" aria-labelledby="menuLateralTitulo">
            <div class="offcanvas-header d-lg-none">
                <span class="brand" id="menuLateralTitulo"><partial name="_Marca" /></span>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" data-bs-target="#menuLateral" aria-label="Cerrar"></button>
            </div>
            <div class="offcanvas-body flex-column">
                <a class="brand d-none d-lg-flex" asp-controller="Tablero" asp-action="Index"><partial name="_Marca" /></a>

                <p class="nav-caption">General</p>
                <nav class="nav flex-column side-nav">
                    <a class="nav-link @Activo("Tablero")" asp-controller="Tablero" asp-action="Index">
                        <i class="bi bi-grid-1x2"></i> Tablero
                    </a>
                </nav>

                <p class="nav-caption">Registro clínico</p>
                <nav class="nav flex-column side-nav">
                    <a class="nav-link @Activo("Mascotas")" asp-controller="Mascotas" asp-action="Index">
                        <i class="bi bi-heart-pulse"></i> Pacientes
                    </a>
                    <a class="nav-link @Activo("Propietarios")" asp-controller="Propietarios" asp-action="Index">
                        <i class="bi bi-people"></i> Propietarios
                    </a>
                </nav>

                <div class="side-cta mt-auto">
                    <p class="mb-2">¿Llegó un paciente nuevo?</p>
                    <a class="btn btn-accent btn-sm w-100" asp-controller="Mascotas" asp-action="Nuevo">
                        <i class="bi bi-plus-lg"></i> Registrar mascota
                    </a>
                </div>
            </div>
        </aside>

        <div class="app-main">
            
            <header class="topbar d-lg-none">
                <button class="btn btn-icon" type="button" data-bs-toggle="offcanvas" data-bs-target="#menuLateral" aria-controls="menuLateral" aria-label="Abrir menú">
                    <i class="bi bi-list"></i>
                </button>
                <a class="brand brand-dark" asp-controller="Tablero" asp-action="Index"><partial name="_Marca" /></a>
            </header>

            <main class="app-content">
                <div class="page-head">
                    <div>
                        @if (ViewData["Miga"] is string miga)
                        {
                            <p class="page-crumb">@miga</p>
                        }
                        <h1 class="page-title">@ViewData["Title"]</h1>
                        @if (ViewData["Subtitulo"] is string subtitulo)
                        {
                            <p class="page-subtitle">@subtitulo</p>
                        }
                    </div>
                    @if (IsSectionDefined("Acciones"))
                    {
                        <div class="page-actions">@RenderSection("Acciones")</div>
                    }
                </div>

                @RenderBody()
            </main>

            <footer class="app-footer">
                <span>Patitas · Sistema de gestión veterinaria</span>
                <span>ASP.NET Core MVC · @DateTime.Now.Year</span>
            </footer>
        </div>
    </div>

    
    <div class="toast-container position-fixed bottom-0 end-0 p-3">
        @if (TempData["Aviso"] is string aviso)
        {
            <div class="toast toast-ok align-items-center border-0" role="status" aria-live="polite" data-autoshow>
                <div class="d-flex">
                    <div class="toast-body"><i class="bi bi-check-circle-fill me-2"></i>@aviso</div>
                    <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast" aria-label="Cerrar"></button>
                </div>
            </div>
        }
        @if (TempData["Alerta"] is string alerta)
        {
            <div class="toast toast-error align-items-center border-0" role="alert" aria-live="assertive" data-autoshow data-bs-delay="8000">
                <div class="d-flex">
                    <div class="toast-body"><i class="bi bi-exclamation-octagon-fill me-2"></i>@alerta</div>
                    <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast" aria-label="Cerrar"></button>
                </div>
            </div>
        }
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/app.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
